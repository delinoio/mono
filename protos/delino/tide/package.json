{
  "name": "@delino/tide-protos",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    "./v1/*": "./v1/*.ts"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0"
  },
  "devDependencies": {
    "@bufbuild/protoc-gen-es": "2.16.0",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "exports": {
      "./v1/*": {
        "types": "./dist/v1/*.d.ts",
        "default": "./dist/v1/*.js"
      }
    }
  }
}
