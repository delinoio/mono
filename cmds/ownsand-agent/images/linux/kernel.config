# SPDX-License-Identifier: FSL-1.1-ALv2
#
# Configuration fragment of the OwnSand Linux guest kernel. build-kernel.sh
# merges it into the architecture's defconfig. The kernel has no modules:
# every option below must be built in (=y); build-kernel.sh fails when the
# merged configuration does not set one of them.
#
# One kernel serves every hypervisor of its architecture:
# - Virtualization.framework (macOS hosts): virtio PCI devices, a virtio
#   socket device and a virtio console (hvc0).
# - Hyper-V through the Host Compute Service (Windows hosts): VMBus, the
#   synthetic SCSI controller, Hyper-V sockets and the COM1 serial port.
# - Firecracker (Linux hosts): virtio MMIO devices from the command line and
#   the 8250 serial port.

# Virtio transports and devices.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_MMIO_CMDLINE_DEVICES=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_HW_RANDOM=y
CONFIG_HW_RANDOM_VIRTIO=y

# Hypervisor sockets: the guest helper listens on AF_VSOCK. Hyper-V sockets
# appear as AF_VSOCK in Linux guests.
CONFIG_VSOCKETS=y
CONFIG_VIRTIO_VSOCKETS=y
CONFIG_HYPERV_VSOCKETS=y

# Hyper-V guest support.
CONFIG_HYPERV=y
CONFIG_HYPERV_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# File systems of the base image and the guest helper's mounts.
CONFIG_EXT4_FS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_UNIX98_PTYS=y

# Networking: kernel IP autoconfiguration from the ip= argument
# (Firecracker and Virtualization.framework), and the TAP device of the
# network tunnel of the Hyper-V runtime.
CONFIG_NET=y
CONFIG_INET=y
CONFIG_UNIX=y
CONFIG_IP_PNP=y
CONFIG_TUN=y

# Consoles.
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
