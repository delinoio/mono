# delino-accounts web app build configuration.
# Contract: docs/apps-delino-accounts-foundation.md
# PUBLIC_ variables are inlined into the client bundle. Never put secrets here.

# Origin of accounts-api. Default when unset: https://accounts.api.delino.io
PUBLIC_API_ORIGIN=http://127.0.0.1:18100

# Logto tenant endpoint and the application ID of the web app's Logto
# single-page application. Set both or neither. Without them, the billing
# pages show that sign-in is not configured. The app always requests the
# scope accounts:billing for the resource https://accounts.api.delino.io.
PUBLIC_LOGTO_ENDPOINT=
PUBLIC_LOGTO_APP_ID=

# Paddle client-side token (public, not an API key) and its environment,
# sandbox or production. A sandbox token starts with test_ and a production
# token with live_. Without a token, the subscription checkout is not
# configured. Development uses sandbox.
PUBLIC_PADDLE_CLIENT_TOKEN=
PUBLIC_PADDLE_ENVIRONMENT=sandbox
