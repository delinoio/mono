{
  "name": "delino-accounts",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "deploy": {
    "target": "cloudflare-pages",
    "project": "delino-accounts"
  },
  "scripts": {
    "build": "rsbuild build",
    "dev": "node ../../scripts/dev/with-infisical.mjs --path=/delino-accounts -- node node_modules/portless/dist/cli.js run --prefix=",
    "dev:app": "rsbuild dev",
    "preview": "rsbuild preview",
    "test": "rstest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "e2e run"
  },
  "portless": {
    "name": "accounts.delino",
    "script": "dev:app"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.16.1",
    "@rsbuild/core": "2.3.2",
    "@rsbuild/plugin-react": "2.1.1",
    "@rstest/core": "0.12.6",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ai": "7.0.173",
    "e2e": "0.24.0",
    "portless": "0.18.1",
    "typescript": "6.0.3"
  }
}
