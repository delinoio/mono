{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "passThroughEnv": [
        "PUBLIC_API_ORIGIN",
        "PUBLIC_LOGTO_ENDPOINT",
        "PUBLIC_LOGTO_APP_ID",
        "PUBLIC_PADDLE_CLIENT_TOKEN",
        "PUBLIC_PADDLE_ENVIRONMENT",
        "PORTLESS",
        "PORTLESS_*"
      ]
    },
    "build": {
      "env": [
        "PUBLIC_API_ORIGIN",
        "PUBLIC_LOGTO_ENDPOINT",
        "PUBLIC_LOGTO_APP_ID",
        "PUBLIC_PADDLE_CLIENT_TOKEN",
        "PUBLIC_PADDLE_ENVIRONMENT"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/*/e2e.config.ts",
        "$TURBO_ROOT$/apps/*/.env.example"
      ]
    }
  }
}
