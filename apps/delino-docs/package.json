{
  "name": "delino-docs",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "deploy": {
    "target": "cloudflare-pages",
    "project": "delino-docs"
  },
  "scripts": {
    "build": "rspress build",
    "dev": "portless run --prefix=",
    "dev:app": "rspress dev",
    "preview": "node ../../scripts/dev/rspress-preview.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "e2e run"
  },
  "portless": {
    "name": "docs.delino",
    "script": "dev:app"
  },
  "dependencies": {
    "@rspress/core": "2.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.16.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ai": "7.0.177",
    "e2e": "0.24.0",
    "portless": "0.18.1",
    "typescript": "6.0.3"
  }
}
