# OwnSand web console build configuration.
# Contract: docs/apps-ownsand-console-foundation.md
# PUBLIC_ variables are inlined into the client bundle. Never put secrets here.

# Origin of ownsand-api. Default when unset: https://ownsand.api.delino.io
PUBLIC_API_ORIGIN=http://127.0.0.1:8300

# Logto tenant endpoint (an origin) and the application ID of the console's
# single-page application registration. Set both or neither; without them the
# console shows that sign-in is not configured.
PUBLIC_LOGTO_ENDPOINT=https://your-tenant.logto.app
PUBLIC_LOGTO_APP_ID=your-logto-app-id
