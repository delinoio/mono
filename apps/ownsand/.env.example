# OwnSand web console build configuration.
# Contract: docs/apps-ownsand-console-foundation.md
# PUBLIC_ variables are inlined into the client bundle. Never put secrets here.

# Origin of the OwnSand control plane. Default when unset: https://ownsand.api.delino.io
PUBLIC_API_ORIGIN=http://127.0.0.1:8300

# Logto tenant endpoint and the application ID of the console's Logto
# single-page application. Without both, the console shows that sign-in is
# not configured.
PUBLIC_LOGTO_ENDPOINT=
PUBLIC_LOGTO_APP_ID=
# Space-separated extra scopes. The console always requests ownsand:use,
# the scope that the control plane requires.
PUBLIC_LOGTO_SCOPES=

# true runs the console against an in-browser fake API with a fake user, for
# local UI work and the end-to-end suite. Production builds reject it.
PUBLIC_OWNSAND_MOCK_API=false
