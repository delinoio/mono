{
  "name": "tide-console",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "deploy": {
    "target": "cloudflare-pages",
    "project": "tide-console"
  },
  "scripts": {
    "build": "rsbuild build",
    "dev": "node ../../scripts/dev/with-infisical.mjs --path=/apps/tide -- node node_modules/portless/dist/cli.js run --prefix=",
    "dev:app": "rsbuild dev",
    "preview": "rsbuild preview",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "rstest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "e2e run"
  },
  "portless": {
    "name": "tide.delino",
    "script": "dev:app"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-query": "2.3.1",
    "@connectrpc/connect-web": "2.3.0",
    "@delino/tide-protos": "workspace:*",
    "@logto/react": "4.1.3",
    "@tanstack/react-query": "5.106.1",
    "delino-ui": "workspace:*",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tide-sdk": "workspace:*"
  },
  "devDependencies": {
    "@e2e-dev/web": "0.16.1",
    "@rsbuild/core": "2.3.3",
    "@rsbuild/plugin-react": "2.1.1",
    "@rstest/core": "0.12.6",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "ai": "7.0.177",
    "e2e": "0.24.0",
    "happy-dom": "21.0.4",
    "portless": "0.18.1",
    "typescript": "6.0.3"
  }
}
