{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "passThroughEnv": [
        "PUBLIC_API_ORIGIN",
        "PUBLIC_LOGTO_ENDPOINT",
        "PUBLIC_LOGTO_APP_ID",
        "PUBLIC_LOGTO_SCOPES",
        "PUBLIC_TIDE_MOCK_API",
        "PORTLESS",
        "PORTLESS_*"
      ]
    },
    "build": {
      "env": [
        "PUBLIC_API_ORIGIN",
        "PUBLIC_LOGTO_ENDPOINT",
        "PUBLIC_LOGTO_APP_ID",
        "PUBLIC_LOGTO_SCOPES",
        "PUBLIC_TIDE_MOCK_API"
      ],
      "inputs": ["$TURBO_DEFAULT$", ".env", ".env.*"]
    }
  }
}
