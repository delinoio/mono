# SandCrew web console build configuration.
# Contract: docs/apps-sandcrew-console-foundation.md
# PUBLIC_ variables are inlined into the client bundle. Never put secrets here.

# Origin of the SandCrew control plane. Default when unset: https://sandcrew.api.delino.io
PUBLIC_API_ORIGIN=

# Logto tenant endpoint and the application ID of the console's Logto
# single-page application. Without both, the console shows that sign-in is
# not configured.
PUBLIC_LOGTO_ENDPOINT=
PUBLIC_LOGTO_APP_ID=
# Space-separated extra scopes. The console always requests sandcrew:use, the
# scope that the control plane requires.
PUBLIC_LOGTO_SCOPES=

# true runs the console against an in-browser fake API with a fake user, for
# local UI work and the end-to-end suite. Production builds reject it.
PUBLIC_SANDCREW_MOCK_API=false
