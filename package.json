{
  "name": "delinoio-mono",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@10.26.2",
  "engines": {
    "node": ">=24.8.0"
  },
  "scripts": {
    "prepare": "node scripts/install-git-hooks.mjs",
    "build": "turbo run build",
    "dev": "node scripts/dev/start-dev.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test test:tooling",
    "test:e2e": "turbo run test:e2e",
    "test:tooling": "node --test scripts/ci/*.test.mjs scripts/dev/*.test.mjs",
    "format": "node scripts/ci/format-changed.mjs --write",
    "format:check": "node scripts/ci/format-changed.mjs",
    "i18n:check": "pnpm -r --if-present run i18n:check",
    "i18n:translate": "pnpm -r --workspace-concurrency=2 --if-present run i18n:translate",
    "i18n:login": "node packages/delino-i18n/cli/cli.mjs login",
    "i18n:logout": "node packages/delino-i18n/cli/cli.mjs logout",
    "i18n:models": "node packages/delino-i18n/cli/cli.mjs models",
    "i18n:profiles": "node packages/delino-i18n/cli/cli.mjs profiles"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "lefthook": "2.2.2",
    "rstack": "0.8.3",
    "turbo": "2.11.13",
    "wrangler": "4.154.0"
  }
}
