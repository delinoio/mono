{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "passThroughEnv": [
        "ADDR",
        "CORS_ALLOWED_ORIGINS",
        "DATABASE_URL",
        "LOGTO_ENDPOINT",
        "LOG_LEVEL",
        "OWNSAND_API_RESOURCE"
      ]
    },
    "build": {
      "cache": false,
      "passThroughEnv": ["CGO_ENABLED", "GOOS", "GOARCH"]
    },
    "lint": {
      "cache": false
    },
    "test": {
      "cache": false,
      "passThroughEnv": ["OWNSAND_TEST_DATABASE_URL"]
    }
  }
}
