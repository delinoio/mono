{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "passThroughEnv": [
        "ADDR",
        "ALLOW_DIRECT_CLIENT_ADDRESS",
        "LOG_LEVEL",
        "DATABASE_URL",
        "RUN_MIGRATIONS",
        "LOGTO_ISSUER",
        "LOGTO_JWKS_URL",
        "LOGTO_JWKS_FILE",
        "LOGTO_AUDIENCE",
        "NONCE_KEY",
        "NONCE_KEY_PREVIOUS",
        "CORS_ORIGINS",
        "TRUST_PROXY_CLIENT_ADDRESS",
        "STUN_URLS",
        "R2_ENDPOINT",
        "R2_BUCKET",
        "R2_ACCESS_KEY_ID",
        "R2_SECRET_ACCESS_KEY",
        "SNAPSHOT_PART_SIZE_BYTES",
        "STUN_ADDR",
        "STUN_RATE_LIMIT_BYTES_PER_SECOND",
        "STUN_RATE_LIMIT_BURST_BYTES"
      ]
    },
    "build": {
      "cache": false,
      "passThroughEnv": ["CGO_ENABLED", "GOOS", "GOARCH"]
    },
    "lint": {
      "cache": false
    },
    "test": {
      "cache": false,
      "passThroughEnv": ["OWNSAND_TEST_DATABASE_URL", "TMPDIR"]
    }
  }
}
