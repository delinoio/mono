# ownsand-api configuration.
# Contract: docs/servers-ownsand-api-foundation.md (Configuration).
# Names, placeholders and loopback defaults only. Never put real values here.

# Listen address (HTTP/1.1 and h2c). The deployment sets it. Default: 127.0.0.1:18300.
ADDR=127.0.0.1:18300

# One of: debug, info, warn, error. Default: info.
LOG_LEVEL=info

# Postgres connection URL. Required.
DATABASE_URL=postgres://ownsand:<password>@127.0.0.1:5432/ownsand?sslmode=disable

# Apply the embedded migrations at startup (true or false). Default: true.
RUN_MIGRATIONS=true

# Logto issuer, `<tenant endpoint>/oidc`. Required.
LOGTO_ISSUER=https://<tenant>.logto.app/oidc

# Key set of the issuer. Default: LOGTO_ISSUER + "/jwks".
# LOGTO_JWKS_URL=https://<tenant>.logto.app/oidc/jwks

# Local key set file used instead of the URL (end-to-end test issuers only).
# LOGTO_JWKS_FILE=<path to jwks.json>

# API resource indicator (expected `aud`). Default: https://ownsand.api.delino.io.
LOGTO_AUDIENCE=https://ownsand.api.delino.io

# Nonce key shared by every instance: at least 32 random bytes in base64url.
# Unset: a random key per process (one instance only, for development).
NONCE_KEY=<base64url of 32 random bytes>
# Previous nonce key during a rotation; remove it 60 seconds after the switch.
# NONCE_KEY_PREVIOUS=<base64url of 32 random bytes>

# STUN URLs sent to agents and callers (comma-separated).
STUN_URLS=stun:ownsand.api.delino.io:3478

# Cloudflare R2 for snapshot exports. Set all four or none (exports disabled).
# R2_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# R2_BUCKET=<bucket>
# R2_ACCESS_KEY_ID=<access key id>
# R2_SECRET_ACCESS_KEY=<secret access key>

# Snapshot export part size in bytes (5 MiB to 5 GiB). Default: 67108864.
SNAPSHOT_PART_SIZE_BYTES=67108864

# STUN UDP listen address. The container image sets 0.0.0.0:3478; the standalone binary defaults to 127.0.0.1:13478.
STUN_ADDR=127.0.0.1:13478

# STUN response byte budget per source IP. Defaults: 1024 bytes per second, burst 4096.
STUN_RATE_LIMIT_BYTES_PER_SECOND=1024
STUN_RATE_LIMIT_BURST_BYTES=4096

# Browser origins allowed by CORS (comma-separated).
# Default: https://ownsand.delino.io. Development console: http://127.0.0.1:13300.
CORS_ORIGINS=https://ownsand.delino.io

# Client address for rate limits, resolved once at startup:
# 1. TRUST_PROXY_CLIENT_ADDRESS=true uses the last entry of the last
#    X-Forwarded-For header (appended by the Caddy reverse proxy). Default:
#    false. Keep false until the Caddy route is verified to append the header.
# 2. Otherwise ALLOW_DIRECT_CLIENT_ADDRESS=true uses the TCP peer address and
#    ignores forwarded headers. Default: false. Set it only when callers
#    connect to the server directly (the development launcher and the tests
#    set it); behind a proxy the peer is the proxy.
# 3. With both false, requests have no client address and the per-client
#    rate limits do not apply; per-device and per-prefix limits still do.
TRUST_PROXY_CLIENT_ADDRESS=false
ALLOW_DIRECT_CLIENT_ADDRESS=false

# Usage reporting to the delino-accounts API (billing).
# Origin of the delino-accounts API. Default: https://accounts.api.delino.io.
ACCOUNTS_API_ORIGIN=https://accounts.api.delino.io
# Logto machine-to-machine credential with the scope accounts:report-usage of
# the API resource https://accounts.api.delino.io. Set all three or none.
# Unset: usage is still metered into the outbox, and the reporter stays idle
# (development and tests).
# LOGTO_TOKEN_ENDPOINT=https://<tenant>.logto.app/oidc/token
# ACCOUNTS_M2M_CLIENT_ID=<machine-to-machine application id>
# ACCOUNTS_M2M_CLIENT_SECRET=<machine-to-machine application secret>

# Internal Prometheus listener (GET /metrics), host:port. Never route it
# through the reverse proxy. Default: empty (listener off).
# METRICS_ADDR=0.0.0.0:9300
