# ownsand-api configuration.
# Contract: docs/servers-ownsand-api-foundation.md
# Secrets have placeholders only; real values live in the service's env file.

# Listen address for HTTP/1.1 and h2c. Default: 127.0.0.1:8300 (loopback only).
ADDR=127.0.0.1:8300

# One of: debug, info, warn, error. Default: info.
LOG_LEVEL=info

# Postgres connection string. Required. Secret.
DATABASE_URL=postgres://<user>:<password>@127.0.0.1:5432/<database>?sslmode=disable

# Logto tenant endpoint (issuer <endpoint>/oidc, JWKS <endpoint>/oidc/jwks).
# Unset: every Logto access token is rejected.
LOGTO_ENDPOINT=https://<tenant>.logto.app

# Logto API resource indicator. Default: https://ownsand.api.delino.io.
OWNSAND_API_RESOURCE=https://ownsand.api.delino.io

# Comma-separated browser origins that CORS allows.
# Default: https://ownsand.delino.io. Local console: http://127.0.0.1:3300.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3300

# Base64 key (at least 32 bytes) that authenticates device challenge nonces.
# Every instance shares it. Unset: device authentication answers unavailable.
# Secret. Generate one with: openssl rand -base64 32
# OWNSAND_NONCE_KEY=<base64-32-bytes>

# Previous nonce key during a rotation; remove it 60 seconds after the new key
# is live on every instance. Secret.
# OWNSAND_NONCE_KEY_PREVIOUS=

# Cloudflare R2 for snapshot exports. Set all four or none. Unset: exports
# answer unavailable and R2 clean-up jobs stay pending. The keys are secrets.
# R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# R2_BUCKET=<bucket>
# R2_ACCESS_KEY_ID=<access-key-id>
# R2_SECRET_ACCESS_KEY=<secret-access-key>

# Signed agent release manifest URL sent to agents in the configuration.
# OWNSAND_RELEASE_MANIFEST_URL=https://<release-host>/ownsand-agent/manifest
