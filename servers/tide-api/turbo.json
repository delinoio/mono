{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "passThroughEnv": [
        "ADDR",
        "ALLOW_DIRECT_CLIENT_ADDRESS",
        "LOG_LEVEL",
        "DATABASE_URL",
        "RUN_MIGRATIONS",
        "LOGTO_ISSUER",
        "LOGTO_JWKS_URL",
        "LOGTO_JWKS_FILE",
        "LOGTO_AUDIENCE",
        "CORS_ORIGINS",
        "TRUST_PROXY_CLIENT_ADDRESS",
        "TIDE_SECRET_KEYS",
        "METRICS_ADDR",
        "OWNSAND_API_ORIGIN",
        "PUBLIC_ORIGIN",
        "OTEL_*"
      ]
    },
    "build": {
      "cache": false,
      "passThroughEnv": ["CGO_ENABLED", "GOOS", "GOARCH"]
    },
    "lint": {
      "cache": false
    },
    "test": {
      "cache": false,
      "passThroughEnv": ["TIDE_TEST_DATABASE_URL", "TMPDIR"]
    }
  }
}
