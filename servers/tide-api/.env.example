# tide-api configuration.
# Contract: docs/servers-tide-api-foundation.md (Configuration).
# Names, placeholders and loopback defaults only. Never put real values here.

# Listen address (HTTP/1.1 and h2c). The deployment sets it. Default: 127.0.0.1:18400.
ADDR=127.0.0.1:18400

# One of: debug, info, warn, error. Default: info.
LOG_LEVEL=info

# Postgres connection URL. Required.
DATABASE_URL=postgres://tide:<password>@127.0.0.1:5432/tide?sslmode=disable

# Apply the embedded migrations at startup (true or false). Default: true.
RUN_MIGRATIONS=true

# Logto issuer, `<tenant endpoint>/oidc`. Required.
LOGTO_ISSUER=https://<tenant>.logto.app/oidc

# Key set of the issuer. Default: LOGTO_ISSUER + "/jwks".
# LOGTO_JWKS_URL=https://<tenant>.logto.app/oidc/jwks

# Local key set file used instead of the URL (end-to-end test issuers only).
# LOGTO_JWKS_FILE=<path to jwks.json>

# API resource indicator (expected `aud`). Default: https://tide.api.delino.io.
# Access tokens need the scope tide:use.
LOGTO_AUDIENCE=https://tide.api.delino.io

# Browser origins allowed by CORS (comma-separated).
# Default: https://tide.delino.io. Development console: http://127.0.0.1:13400.
CORS_ORIGINS=https://tide.delino.io

# Client address for rate limits, resolved once at startup, with the same
# rules as ownsand-api:
# 1. TRUST_PROXY_CLIENT_ADDRESS=true uses the last entry of the last
#    X-Forwarded-For header (appended by the Caddy reverse proxy). Default:
#    false. Keep false until the Caddy route is verified to append the header.
# 2. Otherwise ALLOW_DIRECT_CLIENT_ADDRESS=true uses the TCP peer address and
#    ignores forwarded headers. Default: false. Set it only when callers
#    connect to the server directly (the development launcher and the tests
#    set it); behind a proxy the peer is the proxy.
# 3. With both false, requests have no client address and the per-client
#    rate limit does not apply; the per-prefix and per-user limits still do.
TRUST_PROXY_CLIENT_ADDRESS=false
ALLOW_DIRECT_CLIENT_ADDRESS=false

# Service secret. Required. Comma-separated <key ID>:<key> entries; each key
# is 32 random bytes in base64 (for example from `openssl rand -base64 32`),
# and a key ID is 1 to 32 letters, digits, '-' or '_'. The first entry is the
# primary key that encrypts new values; keep older keys after it until the
# stored values are re-encrypted. Secret.
TIDE_SECRET_KEYS=<key id>:<base64 of 32 random bytes>

# Origin of the OwnSand API that tide calls with the OwnSand API key of each
# organization. Default: https://ownsand.api.delino.io. A local ownsand-api:
# http://127.0.0.1:18300.
OWNSAND_API_ORIGIN=https://ownsand.api.delino.io

# Public origin of this server, used in the webhook URLs that admins register
# (for example the OpenAI Codex webhook URL). Default: https://tide.api.delino.io.
PUBLIC_ORIGIN=https://tide.api.delino.io

# The tide GitHub App (github.com only). Set all six GITHUB_APP_* values or
# none: without them the GitHub layer is off, GitHubService RPCs fail with
# failed_precondition and POST /webhooks/github answers 503.
# Numeric app ID.
# GITHUB_APP_ID=<app id>
# App client ID (the issuer of the app JWT and the OAuth client).
# GITHUB_APP_CLIENT_ID=<client id>
# App client secret, for the OAuth code exchange of LinkGitHubInstallation. Secret.
# GITHUB_APP_CLIENT_SECRET=<client secret>
# App private key in PEM (PKCS #1 or PKCS #8); literal \n sequences are
# accepted instead of line breaks. Secret.
# GITHUB_APP_PRIVATE_KEY=<PEM private key>
# Webhook secret of the app, at least 16 characters. Secret.
# GITHUB_APP_WEBHOOK_SECRET=<webhook secret>
# App slug: the installation URL is <GITHUB_WEB_ORIGIN>/apps/<slug>/installations/new.
# GITHUB_APP_SLUG=<app slug>
# GitHub origins. Defaults: https://api.github.com and https://github.com.
# Override them only for tests against a fake GitHub API.
# GITHUB_API_ORIGIN=https://api.github.com
# GITHUB_WEB_ORIGIN=https://github.com

# Internal Prometheus listener (GET /metrics), host:port. Never route it
# through the reverse proxy. Default: empty (listener off). The development
# launcher sets 127.0.0.1:19400.
# METRICS_ADDR=127.0.0.1:19400

# OTLP/HTTP export of metrics and logs, for example to Grafana Cloud.
# Default: empty (export off). The OpenTelemetry SDK reads these and the
# other standard OTEL_* variables.
# OTEL_EXPORTER_OTLP_ENDPOINT=https://<otlp gateway>/otlp
# Secret.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <credential>
