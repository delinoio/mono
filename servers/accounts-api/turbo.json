{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "passThroughEnv": [
        "ADDR",
        "LOG_LEVEL",
        "DATABASE_URL",
        "RUN_MIGRATIONS",
        "LOGTO_ISSUER",
        "LOGTO_AUDIENCE",
        "LOGTO_MANAGEMENT_ENDPOINT",
        "LOGTO_M2M_CLIENT_ID",
        "LOGTO_M2M_CLIENT_SECRET",
        "CORS_ORIGINS",
        "WEB_ORIGIN",
        "RESEND_API_KEY",
        "EMAIL_FROM",
        "METRICS_ADDR",
        "OTEL_*",
        "PADDLE_ENVIRONMENT",
        "PADDLE_API_KEY",
        "PADDLE_WEBHOOK_SECRET",
        "PADDLE_SUBSCRIPTION_PRICE_ID",
        "PADDLE_TOP_UP_PRODUCT_ID",
        "USAGE_SERVICE_CLIENTS"
      ]
    },
    "build": {
      "cache": false,
      "passThroughEnv": ["CGO_ENABLED", "GOOS", "GOARCH"]
    },
    "lint": {
      "cache": false
    },
    "test": {
      "cache": false,
      "passThroughEnv": ["ACCOUNTS_TEST_DATABASE_URL"]
    }
  }
}
