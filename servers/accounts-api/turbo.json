{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "dev": {
      "passThroughEnv": ["ADDR", "LOG_LEVEL"]
    },
    "build": {
      "cache": false,
      "passThroughEnv": ["CGO_ENABLED", "GOOS", "GOARCH"]
    },
    "lint": {
      "cache": false
    },
    "test": {
      "cache": false
    }
  }
}
