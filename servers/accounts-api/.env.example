# accounts-api configuration.
# Contract: docs/servers-accounts-api-foundation.md
# Names, placeholders and safe loopback defaults only. Secrets come from the
# Infisical /servers/accounts-api development folder or the Droplet env file.

# Listen address in host:port form. Default: 127.0.0.1:18100 (loopback only).
ADDR=127.0.0.1:18100

# One of: debug, info, warn, error. Default: info.
LOG_LEVEL=info

# Required. Postgres connection URL. Secret.
DATABASE_URL=

# Apply the embedded goose migrations at startup. Default: true.
RUN_MIGRATIONS=true

# Required. Logto issuer, <tenant endpoint>/oidc.
LOGTO_ISSUER=

# Expected access token audience. Default: https://accounts.api.delino.io.
LOGTO_AUDIENCE=https://accounts.api.delino.io

# Required. Default Logto endpoint of the tenant (https://<tenant-id>.logto.app)
# for the Management API, which reads the primary email of the caller of
# AcceptInvitation and member display names.
LOGTO_MANAGEMENT_ENDPOINT=

# Required. Machine-to-machine application for the Logto Management API.
LOGTO_M2M_CLIENT_ID=
# Required. Its secret. Secret.
LOGTO_M2M_CLIENT_SECRET=

# Comma-separated browser origins. Default: https://accounts.delino.io. The
# development launcher adds the local web app origins when this is unset.
CORS_ORIGINS=

# Origin of the web app in invitation email links. Default:
# https://accounts.delino.io. The development launcher uses
# https://accounts.delino.localhost when this is unset.
WEB_ORIGIN=

# Required. Resend API key. Secret.
RESEND_API_KEY=

# Required. Sender address of billing emails, for example
# Delino <billing@example.com>.
EMAIL_FROM=

# host:port of the internal Prometheus listener (GET /metrics). Empty turns
# it off. It is never served through the public listener.
METRICS_ADDR=
