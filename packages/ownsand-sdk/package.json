{
  "name": "ownsand-sdk",
  "version": "0.0.0",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "browser": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "rstest run",
    "test:node": "node scripts/check-workspace-import.mjs"
  },
  "dependencies": {
    "@bufbuild/protobuf": "2.16.0",
    "@connectrpc/connect": "2.3.0",
    "@connectrpc/connect-web": "2.3.0",
    "@delino/ownsand-protos": "workspace:*"
  },
  "devDependencies": {
    "@rstest/core": "0.12.6",
    "@types/node": "24.19.2",
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
